{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "mcpServers": {
    "scopesentry": {
      "type": "http",
      "url": "http://127.0.0.1:8082/mcp",
      "headers": {
        "X-API-Key": "${SCOPESENTRY_API_KEY}"
      },
      "enabled": false,
      "instructions": true
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp", "--headless"],
      "enabled": false,
      "instructions": true
    },
    "jshook": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@jshookmcp/jshook@0.3.4"],
      "env": {
        "JSHOOK_BASE_PROFILE": "search"
      },
      "enabled": false,
      "instructions": true
    },
    "idapro": {
      "type": "http",
      "url": "http://127.0.0.1:13337/mcp",
      "enabled": false,
      "instructions": true
    },
    "ghidra": {
      "type": "http",
      "url": "http://127.0.0.1:8765/mcp",
      "enabled": false,
      "instructions": true
    },
    "sliver": {
      "type": "stdio",
      "command": "sliver-client",
      "args": ["mcp", "--config", "${SLIVER_MULTIPLAYER_CFG}"],
      "enabled": false,
      "instructions": true
    }
  },
  "disabledServers": ["scopesentry", "playwright", "jshook", "idapro", "ghidra", "sliver"]
}
