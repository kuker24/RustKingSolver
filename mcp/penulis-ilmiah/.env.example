# Mailto header for polite pool Crossref/OpenAlex (highly recommended: use YOUR OWN email)
# Empty/unset -> server falls back to open-code-highend@users.noreply.github.com
# Example: CROSSREF_MAILTO=your-email@example.com
CROSSREF_MAILTO=

# Optional OpenAlex API key to increase rate limit
OPENALEX_API_KEY=


# Maximum KBBI online lookup queries per minute (default: 20)
KBBI_RATE_PER_MIN=20

# Cache directory for KBBI and DOI metadata (default: ~/.cache/penulis-ilmiah)
PENULIS_CACHE_DIR=
