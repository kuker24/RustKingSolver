{
  "schemaVersion": 1,
  "servers": {
    "codebase-memory-mcp": {
      "enabled": true,
      "transport": "stdio",
      "command": "codebase-memory-bin"
    },
    "context7": {
      "enabled": true,
      "transport": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "shadcn": {
      "enabled": true,
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "shadcn@4.21.1", "mcp"]
    },
    "exa": {
      "enabled": false,
      "transport": "http",
      "url": "https://mcp.exa.ai/mcp"
    },
    "serena": {
      "enabled": false,
      "transport": "stdio",
      "args": [
        "start-mcp-server",
        "--context",
        "agent",
        "--project-from-cwd",
        "--open-web-dashboard",
        "false"
      ]
    },
    "stitch": {
      "enabled": false,
      "transport": "http",
      "url": "https://stitch.googleapis.com/mcp"
    },
    "reticle": {
      "enabled": false,
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@reticlehq/server@3.5.0", "mcp"]
    },
    "ui-skills": {
      "enabled": false,
      "transport": "http",
      "url": "https://www.ui-skills.com/mcp"
    },
    "markitdown": {
      "enabled": false,
      "transport": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "markitdown-mcp==0.0.1a7",
        "--with",
        "markitdown[all]==0.1.8",
        "markitdown-mcp"
      ]
    },
    "crawl4ai": {
      "enabled": false,
      "transport": "http",
      "url": "http://127.0.0.1:11235/mcp/sse"
    },
    "scrapling": {
      "enabled": false,
      "transport": "stdio",
      "command": "uvx",
      "args": ["--from", "scrapling[ai]==0.4.15", "scrapling", "mcp"]
    },
    "penulis-ilmiah": {
      "enabled": false,
      "transport": "stdio",
      "command": "npx",
      "args": ["tsx", "mcp/penulis-ilmiah/src/index.ts"]
    }
  }
}
