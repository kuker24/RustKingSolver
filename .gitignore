# --- private runtime state (never commit) ---
sessions/
cache/
blobs/
predict/
terminal-sessions/
logs/
run/

# --- databases ---
*.db
*.db-shm
*.db-wal

# --- node & python dependencies & caches ---
node_modules/
**/node_modules/
__pycache__/
**/__pycache__/
*.pyc
**/*.pyc

# --- large binaries (>100MB blocked by GitHub) ---
bin/codebase-memory-mcp
# --- secrets & local tokens ---
.env
*.env
**/broker.token
